# Optional: HelmCode Connect source builds
# `cp .env.example .env` enables HelmCode Connect against the production deployment.
# These are the same public identifiers baked into official release builds, not
# secrets. Remove or comment them out to build with cloud features disabled.
# Do not add server-side secrets to this file.

# Production Clerk instance. To use your own, get these from the Clerk Dashboard
# under API keys, JWT templates, and OAuth applications.
HELMCODE_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsudDMuY29kZXMk
HELMCODE_CLERK_JWT_TEMPLATE=helmcode-relay
HELMCODE_CLERK_CLI_OAUTH_CLIENT_ID=hzxSgY2cH10sDU2r

# Optional: signed macOS passkey builds. The RP domain defaults to the Frontend API
# hostname encoded in HELMCODE_CLERK_PUBLISHABLE_KEY. Set the override only when Clerk
# returns a different RP ID or when multiple domains must be entitled.
# HELMCODE_APPLE_TEAM_ID=ABC1234567
# HELMCODE_MACOS_PROVISIONING_PROFILE=/absolute/path/to/helmcode.provisionprofile
# HELMCODE_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.example.com

# Production relay. For a self-hosted relay, `infra/relay` deploys update it
# automatically.
HELMCODE_RELAY_URL=https://relay.t3.codes

# Optional: hosted app origin used by the CLI's out-of-band OAuth flow.
# Defaults to https://app.t3.codes; override to test against a staging deployment.
# HELMCODE_HOSTED_APP_URL=https://nightly.app.t3.codes

# Optional: desktop auto-update repository slug (owner/repo).
# Falls back to GITHUB_REPOSITORY in CI.
HELMCODE_DESKTOP_UPDATE_REPOSITORY=buluma/helmcode

# Public, ingest-only mobile OpenTelemetry configuration.
# HELMCODE_MOBILE_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# HELMCODE_MOBILE_OTLP_TRACES_DATASET=helmcode-code-mobile-traces-dev
# HELMCODE_MOBILE_OTLP_TRACES_TOKEN=xaat-...
